# MongoDB connection string (MongoDB Atlas or local instance)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/bonmariage?retryWrites=true&w=majority

# Server port
PORT=5000

# Secret key required in the "x-admin-key" header for all admin write operations.
# Change this to a long random string before deploying.
ADMIN_KEY=change-this-to-a-strong-secret

# Environment
NODE_ENV=development
